# ThoughtSpot Configuration
# Get these from your ThoughtSpot instance
THOUGHTSPOT_BASE_URL=https://your-thoughtspot-instance.com
THOUGHTSPOT_AUTH_TOKEN=your_thoughtspot_auth_token_here

# AI API Configuration
# You can configure one or more LLM providers

# Claude API (Anthropic)
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API (ChatGPT)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider Selection
# Choose which LLM to use: claude, openai, or gemini
LLM_PROVIDER=claude

# Server Configuration
PORT=5005
