# ThoughtSpot Configuration
# Get these from your ThoughtSpot instance
THOUGHTSPOT_BASE_URL=https://your-thoughtspot-instance.com
THOUGHTSPOT_AUTH_TOKEN=your_thoughtspot_auth_token_here

# AI API Configuration
# You can configure one or more LLM providers

# Claude API (Anthropic)
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API (ChatGPT)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider Selection
# Choose which LLM to use: claude, openai, or gemini
LLM_PROVIDER=claude

# LLM Model Selection (specific model for each provider)
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-o1-mini, gpt-o3-mini
# Claude models: claude-sonnet-4-20250514, claude-sonnet-4-5-20250929, claude-opus-4-20250514, claude-haiku-4-20250514
# Gemini models: gemini-2.0-flash-exp
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.0-flash-exp

# Server Configuration
PORT=5005
